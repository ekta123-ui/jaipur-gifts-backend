# Backend environment variables for Jaipur Gifts
# Copy this file to .env and fill in values before starting the server.

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/jaipur_gifts?retryWrites=true&w=majority

# JWT configuration
JWT_SECRET=replace_this_with_a_strong_secret
JWT_EXPIRES_IN=7d

# Allowed frontend origins for CORS
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# SMTP email settings
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
# Optional: use custom SMTP host instead of Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_SERVICE=gmail
EMAIL_FROM="Jaipur Gifts" <noreply@jaipurgifts.com>
SUPPORT_EMAIL=support@jaipurgifts.com

# Server settings
PORT=5000
NODE_ENV=development
